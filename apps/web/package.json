{
  "name": "@edgechat/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && node --check scripts/pwa-offline.mjs && node --check scripts/tunnel-smoke.mjs && node --check scripts/local-messaging-smoke.mjs",
    "test": "vitest run --passWithNoTests --exclude 'src/**/*.browser.test.ts'",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "browser:install:firefox": "node node_modules/playwright/cli.js install firefox",
    "browser:install:webkit": "node node_modules/playwright/cli.js install webkit",
    "browser:install:matrix": "node node_modules/playwright/cli.js install firefox webkit",
    "test:browser:firefox": "EDGECHAT_BROWSER=firefox vitest run --config vitest.browser.config.ts",
    "test:browser:webkit": "EDGECHAT_BROWSER=webkit vitest run --config vitest.browser.config.ts",
    "test:browser:matrix": "pnpm run test:browser && pnpm run test:browser:firefox && pnpm run test:browser:webkit",
    "test:pwa": "node scripts/pwa-offline.mjs",
    "test:pwa:firefox": "EDGECHAT_BROWSER=firefox node scripts/pwa-offline.mjs",
    "test:pwa:webkit": "EDGECHAT_BROWSER=webkit node scripts/pwa-offline.mjs",
    "test:pwa:matrix": "pnpm run test:pwa && pnpm run test:pwa:firefox && pnpm run test:pwa:webkit",
    "smoke:tunnel": "node scripts/tunnel-smoke.mjs",
    "smoke:tunnel:https-fallback": "EDGECHAT_SMOKE_BLOCK_WEBSOCKET=1 EDGECHAT_SMOKE_ATTACHMENT_ONLY=1 node scripts/tunnel-smoke.mjs",
    "smoke:local": "node scripts/local-messaging-smoke.mjs",
    "load:local": "node scripts/local-messaging-smoke.mjs --load"
  },
  "dependencies": {
    "@edgechat/client-runtime": "workspace:*",
    "@edgechat/client-storage": "workspace:*",
    "@edgechat/db": "workspace:*",
    "@edgechat/messaging-core": "workspace:*",
    "@edgechat/message-content": "workspace:*",
    "@edgechat/protocol": "workspace:*",
    "@edgechat/sync": "workspace:*",
    "@edgechat/ui": "workspace:*",
    "@huggingface/transformers": "4.3.0",
    "@paddor/zrip": "^0.5.9",
    "@simplewebauthn/browser": "14.0.0",
    "@tabler/icons-solidjs": "^3.48.0",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "solid-js": "^1.9.17",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitest/browser-playwright": "4.1.11",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "latest",
    "vite": "^8.3.1",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11"
  }
}
